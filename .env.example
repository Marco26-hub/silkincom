# Email — Resend
RESEND_API_KEY=re_xxx

# Newsletter — Brevo
BREVO_API_KEY=
BREVO_LIST_ID=

# Analytics
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# Sentry (errors)
