{
  "name": "silkincom",
  "version": "0.1.0",
  "private": true,
  "description": "SILKinCOM - E-commerce Premium Made in Como",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:seed": "supabase db reset --linked && psql $DATABASE_URL -f database/seed.sql",
    "seed:products": "tsx scripts/seed-products.ts",
    "translate": "node scripts/translate-i18n.mjs",
    "translate:check": "node scripts/translate-i18n.mjs --check"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@stripe/react-stripe-js": "^3.6.0",
    "@stripe/stripe-js": "^7.3.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.1",
    "lucide-react": "^0.451.0",
    "next": "^15.3.3",
    "next-intl": "^4.11.0",
    "nuqs": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.13.0",
    "resend": "^4.0.0",
    "slugify": "^1.6.6",
    "stripe": "^17.1.0",
    "tailwind-merge": "^2.5.3",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "supabase": "^2.98.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
